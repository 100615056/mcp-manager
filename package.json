{
  "name": "@waycraft/mcp-manager",
  "version": "0.1.0",
  "description": "MCP server health monitor, auto-restart daemon, and status dashboard",
  "type": "module",
  "bin": {
    "mcp-manager": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": ["mcp", "claude", "modelcontextprotocol", "monitor", "daemon"],
  "author": "Angelica Cusipag",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "execa": "^9.0.0",
    "node-notifier": "^10.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-notifier": "^8.0.5",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
